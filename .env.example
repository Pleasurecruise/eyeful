# Secrets and credentials. mise loads this file and redacts the values in task output.
EYEFUL_DATABASE_URL=postgres://localhost:5432/eyeful?sslmode=disable
EYEFUL_TEST_DATABASE_URL=postgres://localhost:5432/eyeful_test?sslmode=disable

# Encrypts stored provider tokens: openssl rand -base64 32
EYEFUL_TOKEN_KEY=

# GitHub App, required: sign-in and repository access (Development > GitHub App).
EYEFUL_GITHUB_CLIENT_ID=
EYEFUL_GITHUB_CLIENT_SECRET=

# Gitee sign-in, optional: its client ID and secret together.
EYEFUL_GITEE_CLIENT_ID=
EYEFUL_GITEE_CLIENT_SECRET=
