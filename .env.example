# Secrets and credentials. mise loads this file and redacts the values in task output.
# From packages/worker, `pnpm exec cf deploy --secrets-file ../../.env` uploads it as the Worker's secrets.
EYEFUL_WEBHOOK_SECRET=
EYEFUL_GITHUB_APP_ID=
EYEFUL_GITHUB_APP_PRIVATE_KEY=
EYEFUL_ALLOWED_USERS=
EYEFUL_CLOUDFLARE_ACCOUNT_ID=
EYEFUL_AI_GATEWAY_TOKEN=
