FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY workflow/go.mod workflow/go.sum workflow/
COPY local/go.mod local/go.sum local/
RUN go mod download
COPY cmd cmd
COPY internal internal
COPY workflow workflow
COPY local local
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /eyeful-sandbox ./cmd/eyeful-sandbox

FROM node:26-bookworm
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
	&& rm -rf /var/lib/apt/lists/* \
	&& corepack enable
COPY --from=golang:1.27-bookworm /usr/local/go /usr/local/go
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /usr/local/bin/
COPY --from=build /eyeful-sandbox /usr/local/bin/eyeful-sandbox
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH
EXPOSE 8080
ENTRYPOINT ["eyeful-sandbox"]
