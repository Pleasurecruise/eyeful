FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY workflow/go.mod workflow/go.sum workflow/
COPY local/go.mod local/go.sum local/
RUN go mod download
COPY cmd cmd
COPY internal internal
COPY workflow workflow
COPY local local
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /eyeful-sandbox ./cmd/eyeful-sandbox

FROM buildpack-deps:trixie
COPY --from=ghcr.io/jdx/mise:2026.10.21 /usr/local/bin/mise /usr/local/bin/mise
ENV MISE_DATA_DIR=/mise MISE_CONFIG_DIR=/mise MISE_CACHE_DIR=/mise/cache PATH=/mise/shims:$PATH
COPY cmd/eyeful-sandbox/mise.toml /mise/config.toml
RUN mise install
COPY --from=build /eyeful-sandbox /usr/local/bin/eyeful-sandbox
EXPOSE 8080
ENTRYPOINT ["eyeful-sandbox"]
