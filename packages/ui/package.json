{
	"name": "@eyeful/ui",
	"private": true,
	"license": "AGPL-3.0-only",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./app.css": "./dist/app.css"
	},
	"scripts": {
		"dev": "svelte-package --watch",
		"prepare": "svelte-kit sync && svelte-package",
		"typecheck": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.52.0",
		"@pierre/diffs": "1.5.1",
		"@pierre/trees": "1.0.0-beta.6",
		"bits-ui": "2.19.5",
		"cn": "0.4.0",
		"mode-watcher": "1.1.0",
		"shadcn-svelte": "1.7.0",
		"svelte-sonner": "1.2.1",
		"tailwind-variants": "3.3.1",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/package": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"paneforge": "1.0.2",
		"svelte": "catalog:",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	}
}
