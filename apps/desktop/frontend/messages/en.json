	"head": "Head",
	"head_hint": "Commit or branch to review; empty reviews uncommitted changes.",
	"apply": "Apply",
	"agent": "Agent",
	"no_agent": "No agent",
	"not_installed": "{tool} is not on PATH",
	"connected": "Connected to {name} {version}. Reviews now use it.",
