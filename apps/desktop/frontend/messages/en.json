		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} file not reviewed",
				"countPlural=other": "{count} files not reviewed"
			}
		}
	],
	"why": "Why",
	"failure_scenario": "Failure scenario",
	"how_verified": "Verification",
